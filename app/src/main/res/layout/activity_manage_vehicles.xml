<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF9F6">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#FDD104"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage Vehicles"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="View, Search &amp; Delete Vehicles"
            android:textColor="#333333"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Search Card -->

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_height="wrap_content"
        app:hintEnabled="false"
        app:startIconDrawable="@android:drawable/ic_menu_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search Vehicle"
            android:minHeight="48dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Vehicle Count -->

    <TextView
        android:id="@+id/txtVehicleCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="#FDD104"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="Total Vehicle Count : 0"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textStyle="bold"/>

    <!-- Empty State -->

    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="60dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:alpha="0.4"
            android:src="@android:drawable/ic_menu_agenda"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No Vehicles Added Yet"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Add vehicles to start managing them"
            android:textColor="#888888"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- Vehicle List -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerVehicles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp" />

</LinearLayout>