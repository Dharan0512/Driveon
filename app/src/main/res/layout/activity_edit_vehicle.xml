<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@drawable/bg_header"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Vehicle"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update vehicle details"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Vehicle Details -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehicle Details"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etBikeName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textCursorDrawable="@drawable/cursor_brand"
                android:hint="Enter Bike Name"/>

            <!-- Vehicle Number -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Vehicle Number"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etVehicleNumber"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Vehicle Number"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:enabled="false"
                android:focusable="false"/>




            <!-- Rental Package Prices -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Rental Package Prices"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- Row 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 Day Price"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etDay1Price"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="₹ Enter Price"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textCursorDrawable="@drawable/cursor_brand"
                        android:inputType="number"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 Day Price"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etDay2Price"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="₹ Enter Price"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textCursorDrawable="@drawable/cursor_brand"
                        android:inputType="number"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Row 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 Day Price"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etDay7Price"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="₹ Enter Price"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textCursorDrawable="@drawable/cursor_brand"
                        android:inputType="number"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 Day Price"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etDay30Price"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="₹ Enter Price"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textCursorDrawable="@drawable/cursor_brand"
                        android:inputType="number"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Extra KM Charges -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Extra KM Charges"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- Row 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 Day Extra KM"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etDay1ExtraKm"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="₹ / KM"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textCursorDrawable="@drawable/cursor_brand"
                        android:inputType="numberDecimal"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 Day Extra KM"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etDay2ExtraKm"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="₹ / KM"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textCursorDrawable="@drawable/cursor_brand"
                        android:inputType="numberDecimal"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Row 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 Day Extra KM"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etDay7ExtraKm"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="₹ / KM"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textCursorDrawable="@drawable/cursor_brand"
                        android:inputType="numberDecimal"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 Day Extra KM"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etDay30ExtraKm"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="₹ / KM"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textCursorDrawable="@drawable/cursor_brand"
                        android:inputType="numberDecimal"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Custom Package -->

            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/brand"
                android:text="UPDATE VEHICLE"
                android:textColor="@color/on_brand"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
