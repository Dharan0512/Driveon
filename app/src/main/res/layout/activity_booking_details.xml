<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Booking Details"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#F5F5F5"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehicle Number"
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtVehicleNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Select Package"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/packageGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbHourly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hourly" />

            <RadioButton
                android:id="@+id/rb1Day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 Day" />

            <RadioButton
                android:id="@+id/rb2Day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 Days" />

            <RadioButton
                android:id="@+id/rb7Day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 Days" />

            <RadioButton
                android:id="@+id/rb30Day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 Days" />

            <RadioButton
                android:id="@+id/rbCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom" />

        </RadioGroup>

        <TextView
            android:id="@+id/txtCustomTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Custom Package"
            android:textStyle="bold"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/etCustomDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Number of Days"
            android:inputType="number"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/etCustomPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Proposed Price"
            android:inputType="number"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/etCustomRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Remarks"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/etStartReading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="#F5F5F5"
            android:hint="Start Speedometer Reading"
            android:padding="12dp"
            android:inputType="number" />

        <Button
            android:id="@+id/btnUploadSpeedometer"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#FDD104"
            android:text="Upload Speedometer Photo"
            android:textColor="#000000"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgSpeedometer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="15dp"
            android:background="#F5F5F5"
            android:scaleType="centerCrop" />

        <Button
            android:id="@+id/btnFinish"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#FDD104"
            android:text="Book Now"
            android:textColor="#000000"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>